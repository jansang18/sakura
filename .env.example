# ── 동네벚꽃 환경변수 ──

# Supabase (백엔드). 설정하면 온보딩 결과가 profiles/saju_private에 저장됨.
# 미설정 시 앱은 로컬 인메모리 store로 그대로 동작한다.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Claude 심층 리포트(유료 성격/궁합)용 — 서버 전용 키. 절대 EXPO_PUBLIC_ 접두사 붙이지 말 것!
# 미설정 시 규칙 기반 템플릿 문구로 자동 폴백.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# (선택) 네이티브 기기에서 /api/report 호출 시 dev 서버 주소
# EXPO_PUBLIC_API_BASE=http://192.168.0.10:8081
